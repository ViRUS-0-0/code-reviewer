{
    "name": "code-review",
    "displayName": "Code Review AI",
    "description": "AI-powered code review and knowledge indexing",
    "version": "0.0.2",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "capabilities": {
        "languageModelAccess": true
    },
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "code-review.reviewChanges",
                "title": "Code Review: Review Changes"
            },
            {
                "command": "code-review.selectSource",
                "title": "Code Review: Select Review Source"
            },
            {
                "command": "code-review.setSource",
                "title": "Code Review: Set Review Source"
            }
        ],
        "configuration": {
            "title": "Code Review AI",
            "properties": {
                "code-review.aiProvider": {
                    "type": "string",
                    "enum": [
                        "Antigravity",
                        "GitHub Copilot",
                        "OpenAI",
                        "Gemini",
                        "oMLX"
                    ],
                    "default": "Antigravity",
                    "description": "The AI provider to use for generating code reviews."
                },
                "code-review.antigravityModel": {
                    "type": "string",
                    "default": "auto",
                    "description": "Preferred Antigravity / Gemini model family (e.g. 'auto', 'gemini-3.7-flash', 'gemini-3.1-pro', 'pro', 'flash')."
                },
                "code-review.antigravityEndpoint": {
                    "type": "string",
                    "default": "",
                    "description": "Optional custom HTTP OpenAI-compatible endpoint URL for Antigravity sidecar/daemon (leave empty to use in-editor Language Model API)."
                },
                "code-review.antigravityApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Optional API key when using a custom Antigravity HTTP endpoint."
                },
                "code-review.openaiApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API Key for OpenAI. Required if AI Provider is set to OpenAI."
                },
                "code-review.geminiApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API Key for Google Gemini. Required if AI Provider is set to Gemini."
                },
                "code-review.omlxBaseUrl": {
                    "type": "string",
                    "default": "http://127.0.0.1:8197/v1",
                    "description": "Base URL for the oMLX provider (local LLM)."
                },
                "code-review.omlxModel": {
                    "type": "string",
                    "default": "Qwen3-1.7B-MLX-4bit",
                    "description": "Model name to use with oMLX provider."
                },
                "code-review.omlxApiKey": {
                    "type": "string",
                    "default": "0950",
                    "description": "API Key for oMLX provider. If left blank, 'no-key-needed' will be used."
                },
                "code-review.githubToken": {
                    "type": "string",
                    "default": "",
                    "description": "GitHub Personal Access Token used to fetch PRs (leave blank to be prompted)"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "code-review-explorer",
                    "title": "Code Review",
                    "icon": "$(checklist)"
                }
            ]
        },
        "views": {
            "code-review-explorer": [
                {
                    "type": "webview",
                    "id": "code-review-sidebar",
                    "name": "AI Code Review"
                },
                {
                    "type": "webview",
                    "id": "code-review-pr-selection",
                    "name": "PR Selection"
                }
            ]
        },
        "chatParticipants": [
            {
                "id": "code-review.agent",
                "name": "code-review",
                "description": "Expert code review agent that analyzes diffs and PRs.",
                "isSticky": true
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "echo 'No linting yet'",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.1",
        "@types/node": "16.x",
        "@types/vscode": "^1.90.0",
        "@vscode/test-electron": "^2.2.3",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@octokit/rest": "^20.0.0",
        "axios": "^1.3.4",
        "openai": "^4.0.0"
    }
}
